# Example additive snippet for the existing readingisalifestyle.com SSL server block.
# Keep your Hugo site root locations as-is; only add these location blocks.
# Do not replace or modify your existing location / block.

# Redirect the no-slash path to the canonical app URL.
location = /virtualreadingworld {
    return 301 /virtualreadingworld/;
}

# Serve app static files at /virtualreadingworld/
location /virtualreadingworld/ {
    alias /home/whope2/VirtualReadingWorld/world/dist/;
    try_files $uri $uri/ /virtualreadingworld/index.html;
}

# Proxy API to backend
location /api/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
